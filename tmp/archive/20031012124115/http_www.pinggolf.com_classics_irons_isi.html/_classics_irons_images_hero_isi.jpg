    <style>
        body {
            text-align: center;
            background: url(https://web.archive.org/web/20140902232612im_/http://webdev1.pinggolf.com/images/splash/bg_tile.jpg);
            background-size: 100%;
            background-repeat: repeat-y;
            color: #aaa;
        }
        
        #big-g30 {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            z-index: -1;
            min-width: 1330px;
        }

        #container {
            text-align: left;
            margin: 50px auto;
            display: inline-block;
            width: 1000px;
        }

        #left-side {
            margin-right: 20px;
            text-align: left;
            float: left;
        }

        a {
            text-decoration: none;
            color: #aaa;
            font-family: 'Droid Sans', sans-serif;
            font-size: 13px;
            font-weight: 400;
        }

        .links {
            margin-top: 15px;
        }

            .links #go-to-ping {
                float: right;
            }

        .chevron {
            margin: -4px 5px;
        }

        #video-link {
            clear: both;
            position: relative;
            right: 200px;
            float: right;
            margin-top: 10px;
        }

        #video {
            float: left;
            -webkit-box-shadow: 10px 10px 35px 0px rgba(0,0,0,0.75);
            -ms-box-shadow: 10px 10px 35px 0px rgba(0,0,0,0.75);
            box-shadow: 10px 10px 35px 0px rgba(0,0,0,0.75);
        }

        
