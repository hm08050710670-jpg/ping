<title>
	PING G30
</title></head>

<body>
    <div id="wrapper">
        <div id="container">
            
    <div id="ping-logo" style="height: 65px; text-align: left;">
        <img src="https://web.archive.org/web/20140902232612im_/http://webdev1.pinggolf.com/images/pinglogo.png">
    </div>
    <div id="inner">
        <div id="left-side">
            <div>
                <img src="https://web.archive.org/web/20140902232612im_/http://webdev1.pinggolf.com/images/g30_logo.png">
            </div>
            <div>
                <img src="/web/20140902232612im_/http://www.ping.com/uploadedImages/Home/Promos/2014/G30/turbulator_technology.png" alt="Turbulator Technology">
            </div>
            <div>
                <img id="videoCaptionImageUrl" src="/web/20140902232612im_/http://www.ping.com/uploadedImages/Home/Promos/2014/G30/bubba_longer.png" alt="Bubba Longer">
            </div>
            <div class="links">
                <a id="go-to-g30" href="/web/20140902232612/http://www.ping.com/clubs/driversdetail.aspx?id=17120">Go to G30<img class="chevron" src="https://web.archive.org/web/20140902232612im_/http://webdev1.pinggolf.com/images/chevron_g30.png"></a>
                <a id="go-to-ping" href="/web/20140902232612/http://www.ping.com/default.aspx?splash=1">Continue to PING.com<img class="chevron" src="https://web.archive.org/web/20140902232612im_/http://webdev1.pinggolf.com/images/chevron_g30.png"></a>
            </div>
        </div>
        <div id="video">
            <div id="video1">
                <video id="splashVideo1" class="sublime" poster="https://web.archive.org/web/20140902232612im_/http://webdev1.pinggolf.com/uploadedImages/Videos/New_Products/2015/bubba5.jpg" width="580" height="325" data-autoplay="true">
                    <source src="https://web.archive.org/web/20140902232612im_/http://webdev1.pinggolf.com/uploadedFiles/Videos/New_Products/2015/Bubba_G30_Driver_Test_580x326.mp4"/>
                    <source src="https://web.archive.org/web/20140902232612im_/http://webdev1.pinggolf.com/uploadedFiles/Videos/New_Products/2015/Bubba_G30_Driver_Test_580x326.webm"/>
                    <source src="https://web.archive.org/web/20140902232612im_/http://webdev1.pinggolf.com/uploadedFiles/Videos/New_Products/2015/Bubba_G30_Driver_Test_580x326.ogm"/>
                </video>
            </div>
            <div id="video2" style="display: none">
                <video id="splashVideo2" class="sublime" poster="https://web.archive.org/web/20140902232612im_/http://webdev1.pinggolf.com/uploadedImages/Videos/New_Products/2015/turbulators.jpg" width="580" height="325">
                    <source src="https://web.archive.org/web/20140902232612im_/http://webdev1.pinggolf.com/uploadedFiles/Videos/New_Products/2015/G30_Turbulators_580x326.mp4"/>
                    <source src="https://web.archive.org/web/20140902232612im_/http://webdev1.pinggolf.com/uploadedFiles/Videos/New_Products/2015/G30_Turbulators_580x326.webm"/>
                    <source src="https://web.archive.org/web/20140902232612im_/http://webdev1.pinggolf.com/uploadedFiles/Videos/New_Products/2015/G30_Turbulators_580x326.ogm"/>
                </video>
            </div>
        </div>
        <div id="video-link">
            <a href="javascript:swapVideosAndContent()"><span id="gotoNextVideoText">Play wind tunnel video</span><img class="chevron" src="https://web.archive.org/web/20140902232612im_/http://webdev1.pinggolf.com/images/chevron_g30.png"></a>
        </div>
    </div>


        </div>
        <img id="big-g30" src="https://web.archive.org/web/20140902232612im_/http://webdev1.pinggolf.com/uploadedImages/home/promos/2014/g30/bg.jpg"/>
    </div>
    
    <script>
        var gotoNextVideoText1 = "Play wind tunnel video";
        var gotoNextVideoText2 = "Play Bubba's video";

        var videoCaptionImageSrc1 = "/uploadedImages/Home/Promos/2014/G30/speed_distance.png";
        var videoCaptionImageAlt1 = "Speed & Distance";
        var videoCaptionImageSrc2 = "/uploadedImages/Home/Promos/2014/G30/bubba_longer.png";
        var videoCaptionImageAlt2 = "Bubba Longer";

        var isFirstVideoLoaded = true;

        function swapVideosAndContent() {
            if (isFirstVideoLoaded) {
                isFirstVideoLoaded = false;
                
                $("#videoCaptionImageUrl").attr("src", videoCaptionImageSrc2);
                $("#videoCaptionImageUrl").attr("alt", videoCaptionImageAlt2);
                $("#gotoNextVideoText").text(gotoNextVideoText2);

                $("#video1").hide();
                $("#video2").show();
                sublime.player('splashVideo1').stop();
                sublime.player('splashVideo2').play();

            } else {
                isFirstVideoLoaded = true;

                $("#videoCaptionImageUrl").attr("src", videoCaptionImageSrc1);
                $("#videoCaptionImageUrl").attr("alt", videoCaptionImageAlt1);
                $("#gotoNextVideoText").text(gotoNextVideoText1);

                $("#video2").hide();
                $("#video1").show();
                sublime.player('splashVideo2').stop();
                sublime.player('splashVideo1').play();

            }
        }

        sublime.ready(function () {
            sublime.player('splashVideo1').on('end', function (player) {
                swapVideosAndContent();
            });
            sublime.player('splashVideo2').on('end', function (player) {
                window.location.href = "/Default.aspx?splash=1";
            });
        });

    </script>

</body>
</html>
